# Stage 1: Build binary
FROM golang:1.23-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod ./
# Note: go.sum will be downloaded / generated by go mod download if not present
RUN go mod download || true

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o load-worker ./cmd/worker/main.go

# Stage 2: Production Minimal Runtime
FROM alpine:3.20

WORKDIR /app
RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/load-worker /app/load-worker

# Health check by verifying process is active
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD pgrep load-worker || exit 1

ENTRYPOINT ["/app/load-worker"]
