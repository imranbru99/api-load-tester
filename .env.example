# ========================================================
# API Load Tester (alt) - Environment Configuration
# ========================================================

# HTTP Port exposed on the host via Nginx reverse proxy
PORT_HTTP=80

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=api_load_tester

# InfluxDB Time-Series Configuration
INFLUXDB_USER=alt_admin
INFLUXDB_PASSWORD=AltSecurePassword123!
INFLUXDB_ORG=alt
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=alt-secret-token-super-secure

# Grafana Dashboard Access
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Worker Hardware Resource Limits (Safe Scaling)
WORKER_CPU_LIMIT=2.0
WORKER_MEM_LIMIT=1024M

# Optional Global Webhook Notifications (Slack / Discord / Generic)
DEFAULT_WEBHOOK_URL=
DEFAULT_WEBHOOK_TYPE=slack
