{
  "id": "col-graphql-sample",
  "name": "GraphQL API Collection",
  "description": "GraphQL query and mutation test collection",
  "items": [
    {
      "id": "gql-1",
      "name": "Query User Information",
      "protocol": "graphql",
      "method": "POST",
      "url": "{{baseUrl}}/graphql",
      "body": {
        "type": "graphql",
        "graphql": {
          "query": "query GetUser($id: ID!) { user(id: $id) { id name email role } }",
          "variables": { "id": "101" }
        }
      },
      "assertions": [
        { "type": "status_code", "operator": "equals", "value": 200 }
      ]
    }
  ]
}
